<Project>
	<PropertyGroup>
		<Copyright>Copyright © 2014 njit-77, Inc. All rights reserved.</Copyright>
		<Authors>njit-77</Authors>
		<Owners>njit-77</Owners>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/njit-77/YE.Core</PackageProjectUrl>
		
		<Description>YE.Core是一个基础类库，包括开发常用功能。</Description>
	</PropertyGroup>
	
	<PropertyGroup>
		<TargetFrameworks>net472;net8.0;</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		
		<Version>1.1.$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</Version>
		
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<PackageVersion>$(Version)</PackageVersion>
		<InformationalVersion>$(Version)</InformationalVersion>
		
		<BaseOutputPath>..\bin\</BaseOutputPath>
		<OutputPath>$(BaseOutputPath)</OutputPath>
   </PropertyGroup>
</Project>